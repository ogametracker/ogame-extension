{
    "name": "@ogame-tracker/service-worker",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run typecheck && vite build",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --fix --config ../../.oxlintrc.json .",
        "lint:check": "oxlint --config ../../.oxlintrc.json .",
        "format": "oxfmt --config ../../.oxfmtrc.json .",
        "format:check": "npm run format -- --check"
    },
    "dependencies": {
        "@ogame-tracker/shared": "0.1.0",
        "date-fns": "2.28.0",
        "fast-xml-parser": "4.0.7",
        "idb": "7.0.1"
    },
    "devDependencies": {
        "@types/chrome": "0.0.208",
        "@types/node": "26.6.6",
        "typescript": "5.9.3",
        "vite": "8.3.6"
    }
}
