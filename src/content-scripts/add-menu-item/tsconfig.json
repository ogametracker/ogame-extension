{
    "compilerOptions": {
        "rootDir": "../..",
        "target": "esnext",
        "module": "esnext",
        "strict": true,
        "moduleResolution": "bundler",
        "allowArbitraryExtensions": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "types": [
            "chrome"
        ],
        "lib": [
            "esnext",
            "dom",
            "dom.iterable"
        ]
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "**/node_modules",
        "**/dist"
    ]
}
