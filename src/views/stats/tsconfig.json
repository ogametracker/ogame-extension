{
    "compilerOptions": {
        "rootDir": "../..",
        "target": "esnext",
        "module": "esnext",
        "strict": true,
        "moduleResolution": "bundler",
        "allowArbitraryExtensions": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "types": [
            "chrome"
        ],
        "lib": [
            "esnext",
            "dom",
            "dom.iterable"
        ],
        "jsx": "preserve",
        "importHelpers": true,
        "experimentalDecorators": true,
        "paths": {
            "@stats/*": [
                "./*"
            ],
            "vue": [
                "./node_modules/vue"
            ],
            "vue/types/*": [
                "./node_modules/vue/types/*"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.vue"
    ],
    "exclude": [
        "**/node_modules",
        "**/dist"
    ]
}
