{
  "name": "ogame-tracker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "src/shared",
    "src/views/_shared",
    "src/views/stats",
    "src/views/notifications",
    "src/service-worker",
    "src/content-scripts"
  ],
  "scripts": {
    "dev:firefox": "node scripts/build.js --dev --browser=firefox",
    "dev:chrome": "node scripts/build.js --dev --browser=chrome",
    "build:firefox": "node scripts/build.js --browser=firefox",
    "build:chrome": "node scripts/build.js --browser=chrome",
    "publish": "node scripts/full-release-build.js",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces"
  },
  "devDependencies": {
    "date-fns": "2.28.0",
    "fast-xml-parser": "4.0.7",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "zip-dir": "2.0.0"
  }
}
